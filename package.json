{
  "name": "typescript-threejs-renderer",
  "version": "1.0.0",
  "description": "A project in order to set and prototype 3D rendering with threejs",
  "private": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "dist": "npm run build && electron-builder"
  },
  "author": "Stephen Shabu",
  "license": "ISC",
  "devDependencies": {
    "@types/three": "^0.166.0",
    "copy-webpack-plugin": "^13.0.0",
    "electron": "^40.4.0",
    "electron-builder": "^26.7.0",
    "html-webpack-plugin": "^5.6.6",
    "three": "^0.185.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.3"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.14.0",
    "@dimforge/rapier3d-compat": "^0.14.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.fibrestudio.typscriptthreejsrenderer",
    "productName": "SpartansVBarbarians",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
